// brickc -- the single self-hosted compiler driver, written in Brick.
//
// This is the whole pipeline as one program: it lexes, parses (into the flat
// node arena), resolves imports, runs the checker, and emits C -- the same
// stages that were verified separately against `brick tokdump`, `brick ast`,
// `brick typedump` and `brick emit`, now wired into one command.
//
// With -o naming a file that does not end in .c, brickc goes all the way: it
// writes <output>.c and then runs the C compiler itself (via system), so one
// command turns Brick source into a runnable program. The C compiler is $BRICK_CC
// when set, "cc" otherwise -- the same rule the Go-built `brick` uses.
//
// Usage:
//   brick run selfhost/brickc.brick <input.brick>            # write <input>.c
//   brick run selfhost/brickc.brick <input.brick> -o out.c   # write out.c
//   brick run selfhost/brickc.brick <input.brick> -o -       # print to stdout
//   brick run selfhost/brickc.brick <input.brick> -o prog    # build prog

import "frontend.brick"
import "codegen.brick"

// cName turns "examples/foo.brick" into "examples/foo.c": everything up to the
// last dot, plus ".c"; if there is no dot, just append ".c".
function cName(path: text) -> text {
    var dot = -1
    var i = 0
    while i < path.len {
        if path[i] == '.' {
            dot = i
        }
        i = i + 1
    }
    if dot < 0 {
        return path + ".c"
    }
    return slice(path, 0, dot) + ".c"
}

// endsWith reports whether s ends with tail.
function endsWith(s: text, tail: text) -> bool {
    if tail.len > s.len {
        return false
    }
    return slice(s, s.len - tail.len, s.len) == tail
}

// ccName is the C compiler brickc runs: $BRICK_CC, or "cc".
function ccName() -> text {
    var cc = getenv("BRICK_CC")
    if cc.len == 0 {
        return "cc"
    }
    return cc
}

function main() {
    var argv = args()
    if argv.len < 2 {
        eprint("usage: brick run selfhost/brickc.brick <input.brick> [-o output.c]")
        return
    }
    var input = argv[1]
    var output = cName(input)
    var i = 2
    while i < argv.len {
        if argv[i] == "-o" {
            if i + 1 >= argv.len {
                eprint("brickc: -o needs an argument")
                return
            }
            output = argv[i + 1]
            i = i + 2
        } else {
            eprint("brickc: unknown argument: " + argv[i])
            return
        }
    }

    var c = newChecker()
    var r = loadFile(&mut c, input, List(text))
    if c.failed == 0 {
        collect(&mut c, r.top)
    }
    if c.failed == 0 {
        checkBodies(&mut c, r.top)
    }
    // A program with an error produces no C, and brickc fails like any other
    // compiler; the diagnostic itself was already printed.
    if c.failed != 0 {
        exit(1)
    }
    var s = renderProgram(c, r.top)

    if output == "-" {
        print(slice(s, 0, s.len - 1))
        return
    }
    // -o out.c writes C; -o out writes out.c and then builds out.
    if endsWith(output, ".c") {
        write_file(output, s)
        eprint("brickc: wrote " + output)
        return
    }
    var cfile = output + ".c"
    write_file(cfile, s)
    var cc = ccName()
    var cmd = List(text)
    cmd.push(cc)
    cmd.push("-std=c11")
    cmd.push("-O2")
    cmd.push("-Wall")
    cmd.push("-Wno-unused-parameter")
    cmd.push(cfile)
    cmd.push("-o")
    cmd.push(output)
    var status = system(cmd)
    if status != 0 {
        eprint("brickc: " + cc + " failed with status " + to_text(status))
        exit(1)
    }
    eprint("brickc: wrote " + cfile + " and built " + output)
}
