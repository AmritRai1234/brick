// A Brick-written lexer, the first self-hosted compiler component.
//
// It reads a .brick file and prints the same canonical token dump as
// `brick tokdump` (line, column, kind, then the literal as decimal bytes), so
// `make selfhost` can diff the two over every example.
//
// The scanner itself lives in tokens.brick, shared with the self-hosted parser.
//
// Usage: brick run selfhost/lexer.brick <file.brick>

import "tokens.brick"

// ---------- output: the same dump as `brick tokdump` ----------

function emit(t: Token) {
    var out = Builder()
    out.add(to_text(t.line))
    out.add(" ")
    out.add(to_text(t.col))
    out.add(" ")
    out.add(t.kind)
    out.add(" ")
    out.add(to_text(t.lit.len))
    var i = 0
    while i < t.lit.len {
        out.add(" ")
        out.add(to_text(t.lit[i]))
        i = i + 1
    }
    print(out.build())
}

function main() {
    var argv = args()
    if argv.len < 2 {
        eprint("usage: brick run selfhost/lexer.brick <file.brick>")
        return
    }
    var src = read_file(argv[1])
    var l = Lexer{ src: src, pos: 0, readPos: 0, ch: 0, line: 1, col: 0 }
    readChar(&mut l)

    var done = false
    while !done {
        var t = nextToken(&mut l)
        emit(t)
        if t.kind == "EOF" {
            done = true
        }
    }
}
