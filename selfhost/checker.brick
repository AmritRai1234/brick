// A Brick-written type checker, the third self-hosted component.
//
// It imports the shared front end (frontend.brick): tokenize, parse into a flat
// node arena, resolve imports like the Go loader, and run the same semantic
// analysis as internal/checker. This file adds the canonical type dump — the
// same text `brick typedump` prints — so `make selfhost` can diff the two over
// every example.
//
// Usage: brick run selfhost/checker.brick <file.brick>

import "frontend.brick"

// ---------- dump (mirrors internal/checker/dump.go) ----------

function walkExpr(c: &mut Checker, idx: int) {
    if idx < 0 {
        return
    }
    var n = c.nodes[idx]
    if n.ty != "" {
        c.out.push(to_text(n.line) + ":" + to_text(n.col) + " " + n.kind + " " + n.ty)
    }
    if n.kind == "Binary" {
        walkExpr(c, n.e1)
        walkExpr(c, n.e2)
    } else if n.kind == "Unary" {
        walkExpr(c, n.e1)
    } else if n.kind == "Call" {
        walkExpr(c, n.e1)
        var i = 0
        while i < n.args.len {
            walkExpr(c, n.args[i])
            i = i + 1
        }
    } else if n.kind == "Field" {
        walkExpr(c, n.e1)
    } else if n.kind == "Index" {
        walkExpr(c, n.e1)
        walkExpr(c, n.e2)
    } else if n.kind == "StructLit" {
        var i = 0
        while i < n.args.len {
            walkExpr(c, n.args[i])
            i = i + 1
        }
    }
}

function walkStmt(c: &mut Checker, idx: int) {
    if idx < 0 {
        return
    }
    var n = c.nodes[idx]
    var k = n.kind
    if k == "Var" {
        walkExpr(c, n.e1)
    } else if k == "Assign" {
        walkExpr(c, n.e1)
        walkExpr(c, n.e2)
    } else if k == "Return" {
        walkExpr(c, n.e1)
    } else if k == "ExprStmt" {
        walkExpr(c, n.e1)
    } else if k == "Block" {
        var i = 0
        while i < n.args.len {
            walkStmt(c, n.args[i])
            i = i + 1
        }
    } else if k == "If" {
        walkExpr(c, n.e1)
        walkStmt(c, n.e2)
        if n.e3 >= 0 {
            walkStmt(c, n.e3)
        }
    } else if k == "While" {
        walkExpr(c, n.e1)
        walkStmt(c, n.e2)
    } else if k == "Arena" {
        walkStmt(c, n.e1)
    } else if k == "For" {
        walkExpr(c, n.e1)
        walkStmt(c, n.e2)
    } else if k == "Match" {
        walkExpr(c, n.e1)
        var i = 0
        while i < n.args.len {
            var arm = c.nodes[n.args[i]]
            walkStmt(c, arm.e1)
            i = i + 1
        }
    } else if k == "Func" {
        walkStmt(c, n.e1)
    } else if k == "Const" {
        walkExpr(c, n.e1)
    }
}

function dumpProgram(c: &mut Checker, top: List(int)) {
    var i = 0
    while i < top.len {
        walkStmt(c, top[i])
        i = i + 1
    }
}

function joinLines(lines: List(text)) -> text {
    var b = Builder()
    var i = 0
    while i < lines.len {
        if i > 0 {
            b.add("\n")
        }
        b.add(lines[i])
        i = i + 1
    }
    return b.build()
}

function main() {
    var argv = args()
    if argv.len < 2 {
        eprint("usage: brick run selfhost/checker.brick <file.brick>")
        return
    }
    var c = newChecker()
    var r = loadFile(&mut c, argv[1], List(text))
    collect(&mut c, r.top)
    checkBodies(&mut c, r.top)
    dumpProgram(&mut c, r.top)
    if c.out.len > 0 {
        print(joinLines(c.out))
    }
}
