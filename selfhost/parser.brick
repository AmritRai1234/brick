// A Brick-written parser + AST dumper, the second self-hosted component.
//
// It parses a .brick file (resolving imports exactly like the Go loader) and
// prints the same tree as `brick ast`, so `make selfhost-parser` can diff the
// two over every example.
//
// Rather than building an AST, each parse function returns the dump text of the
// node it parsed, indented relative to itself; the caller shifts the whole
// block right by one level. This keeps the port faithful without needing
// recursive (pointer) types in Brick.
//
// The scanner itself lives in tokens.brick, shared with the self-hosted lexer.
//
// Usage: brick run selfhost/parser.brick <file.brick>

import "tokens.brick"

struct Parser {
    toks: List(Token),
    pos: int,
    noStructLit: int,
}

// ---------- indentation helpers ----------

function spaces(n: int) -> text {
    var b = Builder()
    var i = 0
    while i < n {
        b.add(" ")
        i = i + 1
    }
    return b.build()
}

// Prefix every line of s with 2*levels spaces (but not a trailing empty line).
function shift(s: text, levels: int) -> text {
    if levels <= 0 {
        return s
    }
    var pfx = spaces(levels * 2)
    var b = Builder()
    b.add(pfx)
    var i = 0
    while i < s.len {
        b.add(slice(s, i, i + 1))
        if s[i] == '\n' && i + 1 < s.len {
            b.add(pfx)
        }
        i = i + 1
    }
    return b.build()
}

// String-literal values may contain newlines, which `brick ast` prints raw (it
// does *not* re-indent them). Since our re-indenter keys on '\n', we hide such
// bytes behind a tab escape while assembling: '\t' -> "\t0", '\n' -> "\t1",
// and NUL -> "\t2" (text cannot hold NUL at all). `unprotect` restores the
// original bytes as `bytes`, which `print_bytes` writes unchanged.
function protect(s: bytes) -> text {
    var b = Builder()
    var i = 0
    while i < s.len {
        if s[i] == 9 {
            b.add("\t0")
        } else if s[i] == 10 {
            b.add("\t1")
        } else if s[i] == 0 {
            b.add("\t2")
        } else {
            b.add(to_text(byteString(s[i])))
        }
        i = i + 1
    }
    return b.build()
}

function unprotect(s: text) -> bytes {
    var codes = List(int)
    var i = 0
    while i < s.len {
        if s[i] == '\t' && i + 1 < s.len && s[i + 1] == '0' {
            codes.push(9)
            i = i + 2
        } else if s[i] == '\t' && i + 1 < s.len && s[i + 1] == '1' {
            codes.push(10)
            i = i + 2
        } else if s[i] == '\t' && i + 1 < s.len && s[i + 1] == '2' {
            codes.push(0)
            i = i + 2
        } else {
            codes.push(s[i])
            i = i + 1
        }
    }
    return bytes(codes)
}

function join(items: List(text), sep: text) -> text {
    var b = Builder()
    var i = 0
    while i < items.len {
        if i > 0 {
            b.add(sep)
        }
        b.add(items[i])
        i = i + 1
    }
    return b.build()
}

function parseInt(s: text) -> int {
    var n = 0
    var i = 0
    while i < s.len {
        n = n * 10 + (s[i] - '0')
        i = i + 1
    }
    return n
}

// ---------- cursor helpers ----------

function cur(p: &Parser) -> Token {
    return p.toks[p.pos]
}

function advance(p: &mut Parser) -> Token {
    var t = p.toks[p.pos]
    if p.pos < p.toks.len - 1 {
        p.pos = p.pos + 1
    }
    return t
}

function checkKind(p: &Parser, k: text) -> bool {
    return cur(p).kind == k
}

function matchKind(p: &mut Parser, k: text) -> bool {
    if checkKind(p, k) {
        advance(p)
        return true
    }
    return false
}

function describeTok(t: Token) -> text {
    if t.kind == "EOF" {
        return "end of file"
    }
    if t.kind == "ILLEGAL" {
        return t.lit
    }
    if t.kind == "IDENT" || t.kind == "INT" || t.kind == "FLOAT" || t.kind == "STRING" || t.kind == "CHAR" {
        return t.lit
    }
    return t.kind
}

function expect(p: &mut Parser, k: text) -> Token {
    if !checkKind(p, k) {
        var t = cur(p)
        eprint(to_text(t.line) + ":" + to_text(t.col) + ": expected \"" + k + "\", found \"" + describeTok(t) + "\"")
    }
    return advance(p)
}

// ---------- program & statements ----------

function parseStmt(p: &mut Parser) -> text {
    var k = cur(p).kind
    if k == "function" {
        return parseFuncDecl(p, false)
    }
    if k == "extern" {
        advance(p)
        return parseFuncDecl(p, true)
    }
    if k == "struct" {
        return parseStructDecl(p)
    }
    if k == "enum" {
        return parseEnumDecl(p)
    }
    if k == "match" {
        return parseMatch(p)
    }
    if k == "import" {
        return parseImport(p)
    }
    if k == "var" {
        return parseVarStmt(p)
    }
    if k == "const" {
        return parseConstDecl(p)
    }
    if k == "if" {
        return parseIf(p)
    }
    if k == "while" {
        return parseWhile(p)
    }
    if k == "for" {
        return parseFor(p)
    }
    if k == "arena" {
        return parseArena(p)
    }
    if k == "break" {
        advance(p)
        return "Break\n"
    }
    if k == "continue" {
        advance(p)
        return "Continue\n"
    }
    if k == "return" {
        return parseReturn(p)
    }
    if k == "{" {
        return parseBlock(p)
    }
    return parseSimpleStmt(p)
}

function parseBlock(p: &mut Parser) -> text {
    expect(p, "{")
    var stmts = List(text)
    while !checkKind(p, "}") && !checkKind(p, "EOF") {
        matchKind(p, ";")
        if checkKind(p, "}") {
            break
        }
        stmts.push(parseStmt(p))
    }
    expect(p, "}")
    var s = "Block\n"
    var i = 0
    while i < stmts.len {
        s = s + shift(stmts[i], 1)
        i = i + 1
    }
    return s
}

function parseVarStmt(p: &mut Parser) -> text {
    advance(p) // var
    var name = expect(p, "IDENT")
    var s = "Var " + name.lit
    if matchKind(p, ":") {
        s = s + ": " + parseType(p)
    }
    expect(p, "=")
    var v = parseExpr(p)
    return s + "\n" + shift(v, 1)
}

function parseConstDecl(p: &mut Parser) -> text {
    advance(p) // const
    var name = expect(p, "IDENT")
    var s = "Const " + name.lit
    if matchKind(p, ":") {
        s = s + ": " + parseType(p)
    }
    expect(p, "=")
    var v = parseExpr(p)
    return s + "\n" + shift(v, 1)
}

function parseReturn(p: &mut Parser) -> text {
    advance(p)
    if !checkKind(p, "}") && !checkKind(p, "EOF") {
        var v = parseExpr(p)
        return "Return\n" + shift(v, 1)
    }
    return "Return\n"
}

function parseIf(p: &mut Parser) -> text {
    advance(p)
    p.noStructLit = p.noStructLit + 1
    var cond = parseExpr(p)
    p.noStructLit = p.noStructLit - 1
    var then = parseBlock(p)
    var s = "If\n" + shift("cond:\n", 1) + shift(cond, 2) + shift("then:\n", 1) + shift(then, 2)
    if matchKind(p, "else") {
        var els = ""
        if checkKind(p, "if") {
            els = parseIf(p)
        } else {
            els = parseBlock(p)
        }
        s = s + shift("else:\n", 1) + shift(els, 2)
    }
    return s
}

function parseWhile(p: &mut Parser) -> text {
    advance(p)
    p.noStructLit = p.noStructLit + 1
    var cond = parseExpr(p)
    p.noStructLit = p.noStructLit - 1
    var body = parseBlock(p)
    return "While\n" + shift("cond:\n", 1) + shift(cond, 2) + shift(body, 1)
}

function parseFor(p: &mut Parser) -> text {
    advance(p)
    var name = expect(p, "IDENT")
    expect(p, "in")
    p.noStructLit = p.noStructLit + 1 // so `x {` is not read as a struct literal
    var iter = parseExpr(p)
    p.noStructLit = p.noStructLit - 1
    var body = parseBlock(p)
    return "For " + name.lit + " in\n" + shift(iter, 1) + shift(body, 1)
}

function parseArena(p: &mut Parser) -> text {
    advance(p)
    var body = parseBlock(p)
    return "Arena\n" + shift(body, 1)
}

function parseSimpleStmt(p: &mut Parser) -> text {
    var expr = parseExpr(p)
    if checkKind(p, "=") {
        advance(p)
        var value = parseExpr(p)
        return "Assign\n" + shift("target:\n", 1) + shift(expr, 2) + shift("value:\n", 1) + shift(value, 2)
    }
    return "ExprStmt\n" + shift(expr, 1)
}

function parseFuncDecl(p: &mut Parser, isExtern: bool) -> text {
    expect(p, "function")
    var name = expect(p, "IDENT")
    expect(p, "(")
    var params = List(text)
    while !checkKind(p, ")") {
        var pn = expect(p, "IDENT")
        expect(p, ":")
        params.push(pn.lit + ": " + parseType(p))
        if !matchKind(p, ",") {
            break
        }
    }
    expect(p, ")")
    var ret = "void"
    if matchKind(p, "->") {
        ret = parseType(p)
    }
    var s = "Function " + name.lit + "(" + join(params, ", ") + ") -> " + ret
    if isExtern {
        return s + "  [extern]\n"
    }
    var body = parseBlock(p)
    return s + "\n" + shift(body, 1)
}

function parseStructDecl(p: &mut Parser) -> text {
    advance(p) // struct
    var name = expect(p, "IDENT")
    expect(p, "{")
    var fields = List(text)
    while !checkKind(p, "}") {
        var fn = expect(p, "IDENT")
        expect(p, ":")
        fields.push(fn.lit + ": " + parseType(p))
        if !matchKind(p, ",") {
            break
        }
    }
    expect(p, "}")
    return "Struct " + name.lit + " { " + join(fields, ", ") + " }\n"
}

function parseImport(p: &mut Parser) -> text {
    advance(p) // import
    var path = expect(p, "STRING")
    return "Import " + path.lit + "\n"
}

function parseEnumDecl(p: &mut Parser) -> text {
    advance(p) // enum
    var name = expect(p, "IDENT")
    expect(p, "{")
    var variants = List(text)
    while !checkKind(p, "}") {
        var vn = expect(p, "IDENT")
        var v = vn.lit
        if matchKind(p, "(") {
            var fs = List(text)
            while !checkKind(p, ")") {
                fs.push(parseType(p))
                if !matchKind(p, ",") {
                    break
                }
            }
            expect(p, ")")
            v = v + "(" + join(fs, ", ") + ")"
        }
        variants.push(v)
        if !matchKind(p, ",") {
            break
        }
    }
    expect(p, "}")
    var s = "Enum " + name.lit + "\n"
    var i = 0
    while i < variants.len {
        s = s + shift(variants[i] + "\n", 1)
        i = i + 1
    }
    return s
}

function parseMatch(p: &mut Parser) -> text {
    advance(p) // match
    p.noStructLit = p.noStructLit + 1
    var scr = parseExpr(p)
    p.noStructLit = p.noStructLit - 1
    expect(p, "{")
    var s = "Match\n" + shift("scrutinee:\n", 1) + shift(scr, 2)
    while !checkKind(p, "}") && !checkKind(p, "EOF") {
        matchKind(p, ";")
        if checkKind(p, "}") {
            break
        }
        var pat = parsePattern(p)
        expect(p, "=>")
        var body = ""
        if checkKind(p, "{") {
            body = parseBlock(p)
        } else {
            body = parseStmt(p)
        }
        s = s + shift("arm " + pat + ":\n", 1) + shift(body, 2)
        matchKind(p, ",")
    }
    expect(p, "}")
    return s
}

function parsePattern(p: &mut Parser) -> text {
    var tok = cur(p)
    if tok.kind == "IDENT" && tok.lit == "_" {
        advance(p)
        return "_"
    }
    var en = expect(p, "IDENT")
    expect(p, ".")
    var variant = expect(p, "IDENT")
    var s = en.lit + "." + variant.lit
    if matchKind(p, "(") {
        var binds = List(text)
        while !checkKind(p, ")") {
            binds.push(expect(p, "IDENT").lit)
            if !matchKind(p, ",") {
                break
            }
        }
        expect(p, ")")
        s = s + "(" + join(binds, ", ") + ")"
    }
    return s
}

function parseType(p: &mut Parser) -> text {
    var ptr = false
    if checkKind(p, "&") || checkKind(p, "&mut") {
        ptr = true
        advance(p)
    }
    var name = expect(p, "IDENT")
    var base = name.lit
    if name.lit == "List" && checkKind(p, "(") {
        advance(p)
        var elem = parseType(p)
        expect(p, ")")
        base = "List(" + elem + ")"
    }
    if ptr {
        return "&" + base
    }
    return base
}

// ---------- expressions ----------

function precOf(k: text) -> int {
    if k == "||" {
        return 1
    }
    if k == "&&" {
        return 2
    }
    if k == "==" || k == "!=" {
        return 3
    }
    if k == "<" || k == "<=" || k == ">" || k == ">=" {
        return 4
    }
    if k == "+" || k == "-" {
        return 5
    }
    if k == "*" || k == "/" || k == "%" {
        return 6
    }
    return 0
}

function parseExpr(p: &mut Parser) -> text {
    return parseBinary(p, 1)
}

function parseBinary(p: &mut Parser, minPrec: int) -> text {
    var left = parseUnary(p)
    var goOn = true
    while goOn {
        var op = cur(p)
        var pr = precOf(op.kind)
        if pr == 0 || pr < minPrec {
            goOn = false
        } else {
            advance(p)
            var right = parseBinary(p, pr + 1)
            left = "Binary " + op.lit + "\n" + shift(left, 1) + shift(right, 1)
        }
    }
    return left
}

function parseUnary(p: &mut Parser) -> text {
    var k = cur(p).kind
    if k == "-" || k == "!" || k == "&" || k == "&mut" {
        var op = advance(p)
        var operand = parseUnary(p)
        return "Unary " + op.lit + "\n" + shift(operand, 1)
    }
    return parsePostfix(p)
}

function parsePostfix(p: &mut Parser) -> text {
    var e = parsePrimary(p)
    var goOn = true
    while goOn {
        var k = cur(p).kind
        if k == "(" {
            advance(p)
            var args = List(text)
            while !checkKind(p, ")") {
                args.push(parseExpr(p))
                if !matchKind(p, ",") {
                    break
                }
            }
            expect(p, ")")
            var s = "Call\n" + shift("callee:\n", 1) + shift(e, 2)
            if args.len > 0 {
                s = s + shift("args:\n", 1)
                var i = 0
                while i < args.len {
                    s = s + shift(args[i], 2)
                    i = i + 1
                }
            }
            e = s
        } else if k == "." {
            advance(p)
            var name = expect(p, "IDENT")
            e = "Field ." + name.lit + "\n" + shift(e, 1)
        } else if k == "[" {
            advance(p)
            var idx = parseExpr(p)
            expect(p, "]")
            e = "Index\n" + shift("base:\n", 1) + shift(e, 2) + shift("index:\n", 1) + shift(idx, 2)
        } else {
            goOn = false
        }
    }
    return e
}

function parsePrimary(p: &mut Parser) -> text {
    var tok = cur(p)
    var k = tok.kind
    if k == "INT" {
        advance(p)
        return "Int " + to_text(parseInt(tok.lit)) + "\n"
    }
    if k == "FLOAT" {
        advance(p)
        return "Float " + tok.lit + "\n"
    }
    if k == "STRING" {
        advance(p)
        return "String \"" + protect(tok.raw) + "\"\n"
    }
    if k == "CHAR" {
        advance(p)
        return "Int " + to_text(tok.raw[0]) + "\n"
    }
    if k == "true" {
        advance(p)
        return "Bool true\n"
    }
    if k == "false" {
        advance(p)
        return "Bool false\n"
    }
    if k == "(" {
        advance(p)
        var e = parseExpr(p)
        expect(p, ")")
        return e
    }
    if k == "IDENT" {
        advance(p)
        if checkKind(p, "{") && p.noStructLit == 0 {
            return parseStructLit(p, tok.lit)
        }
        return "Ident " + tok.lit + "\n"
    }
    eprint(to_text(tok.line) + ":" + to_text(tok.col) + ": unexpected \"" + describeTok(tok) + "\"")
    return ""
}

function parseStructLit(p: &mut Parser, name: text) -> text {
    expect(p, "{")
    var fields = List(text)
    while !checkKind(p, "}") {
        var fn = expect(p, "IDENT")
        expect(p, ":")
        var v = parseExpr(p)
        fields.push(shift(fn.lit + ":\n", 1) + shift(v, 2))
        if !matchKind(p, ",") {
            break
        }
    }
    expect(p, "}")
    var s = "StructLit " + name + "\n"
    var i = 0
    while i < fields.len {
        s = s + fields[i]
        i = i + 1
    }
    return s
}

// ---------- program + import resolution (mirrors internal/loader) ----------

function newParser(src: text) -> Parser {
    var l = Lexer{ src: src, pos: 0, readPos: 0, ch: 0, line: 1, col: 0 }
    readChar(&mut l)
    var toks = List(Token)
    var done = false
    while !done {
        var t = nextToken(&mut l)
        toks.push(t)
        if t.kind == "EOF" {
            done = true
        }
    }
    return Parser{ toks: toks, pos: 0, noStructLit: 0 }
}

function dirOf(path: text) -> text {
    var i = path.len - 1
    while i >= 0 {
        if path[i] == '/' {
            return slice(path, 0, i)
        }
        i = i - 1
    }
    return ""
}

function joinPath(dir: text, name: text) -> text {
    if dir == "" {
        return name
    }
    return dir + "/" + name
}

function importFileName(p: text) -> text {
    if p.len >= 6 && slice(p, p.len - 6, p.len) == ".brick" {
        return p
    }
    return p + ".brick"
}

// The set of already-loaded files plus the dump text produced so far. Both are
// threaded through by value (Brick lists are shallow-copied), so no pointer to a
// list is ever needed.
struct Loaded {
    text: text,
    done: List(text),
}

// Depth-first: emit imported files' declarations, then this file's own,
// mirroring internal/loader's merge order.
function loadFile(path: text, done: List(text)) -> Loaded {
    var already = false
    var i = 0
    while i < done.len {
        if done[i] == path {
            already = true
        }
        i = i + 1
    }
    if already {
        return Loaded{ text: "", done: done }
    }
    done.push(path)
    var src = read_file(path)
    var p = newParser(src)
    var dir = dirOf(path)
    var imports = List(text)
    var bodies = List(text)
    while !checkKind(&p, "EOF") {
        matchKind(&mut p, ";")
        if checkKind(&p, "EOF") {
            break
        }
        if checkKind(&p, "import") {
            advance(&mut p)
            var pathTok = expect(&mut p, "STRING")
            imports.push(pathTok.lit)
        } else {
            bodies.push(parseStmt(&mut p))
        }
    }
    var out = Builder()
    i = 0
    while i < imports.len {
        var r = loadFile(joinPath(dir, importFileName(imports[i])), done)
        out.add(r.text)
        done = r.done
        i = i + 1
    }
    i = 0
    while i < bodies.len {
        out.add(bodies[i])
        i = i + 1
    }
    return Loaded{ text: out.build(), done: done }
}

function main() {
    var argv = args()
    if argv.len < 2 {
        eprint("usage: brick run selfhost/parser.brick <file.brick>")
        return
    }
    var r = loadFile(argv[1], List(text))
    // The dump ends with a newline already; print_bytes adds none, so NULs in
    // string literals reach the output instead of truncating a text value.
    print_bytes(unprotect(r.text))
}
