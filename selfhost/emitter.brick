// A Brick-written C emitter, the fourth self-hosted component.
//
// The emit machinery lives in codegen.brick (shared with the full compiler
// driver, selfhost/brickc.brick). This driver runs the front end, renders the C
// and prints it to stdout, matching `brick emit` byte for byte; `make selfhost`
// diffs the two over every example.
//
// Usage: brick run selfhost/emitter.brick <file.brick>

import "frontend.brick"
import "codegen.brick"

function main() {
    var argv = args()
    if argv.len < 2 {
        eprint("usage: brick run selfhost/emitter.brick <file.brick>")
        return
    }
    var c = newChecker()
    var r = loadFile(&mut c, argv[1], List(text))
    collect(&mut c, r.top)
    checkBodies(&mut c, r.top)
    var s = renderProgram(c, r.top)
    // The buffer ends with a newline; print adds one of its own, so drop it
    // here to match `brick emit` byte-for-byte.
    print(slice(s, 0, s.len - 1))
}
