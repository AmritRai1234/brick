// The C runtime prelude emitted at the top of every generated program.
//
// Stored as ordinary string literals (escaped by the same rules cQuote uses in
// internal/codegen) so the emitted text is byte-for-byte what the Go compiler
// writes. This file is imported by selfhost/emitter.brick.

function runtimeText() -> text {
    return "/*\n * Brick runtime support.\n *\n * Growable lists (List(T)) and text helpers used by generated code. This is\n * plain C, written to be read next to the .brick source that produced it.\n */\n\n#define BRICK_LIST_INITIAL_CAPACITY 8\n#define BRICK_LIST_GROWTH_FACTOR    2\n\ntypedef struct\n{\n    void   *data;\n    int64_t len;    /* number of elements in use      */\n    int64_t cap;    /* allocated element capacity     */\n    int64_t elem;   /* size of one element, in bytes  */\n} BrickList;\n\nstatic inline void brick_panic_index(int64_t index)\n{\n    fprintf(stderr, \"brick: index out of bounds: %lld\\n\", (long long)index);\n    exit(1);\n}\n\nstatic inline void brick_panic_memory(void)\n{\n    fprintf(stderr, \"brick: out of memory\\n\");\n    exit(1);\n}\n\n/*\n * Arenas (§6). An arena block owns a chain of chunks with a bump pointer.\n * brick_arena_enter() makes it the active region; allocations made while it is\n * active come from it and are released together by brick_arena_leave(), so\n * freeing is one pass over the chunks instead of a free per object.\n *\n * Data allocated inside an arena must not outlive the block that owns it.\n */\n#define BRICK_ARENA_CHUNK 65536\n\ntypedef struct BrickArenaChunk\n{\n    struct BrickArenaChunk *prev;\n    size_t                  used;\n    size_t                  cap;\n} BrickArenaChunk;\n\ntypedef struct BrickArena\n{\n    struct BrickArena *parent;\n    BrickArenaChunk   *chunk;\n} BrickArena;\n\nstatic BrickArena *brick_arena_top = NULL;\n\nstatic inline void *brick_arena_raw(size_t n)\n{\n    BrickArenaChunk *chunk;\n    size_t           cap;\n    void            *p;\n\n    n = (n + 15u) & ~(size_t)15u;   /* keep 16-byte alignment */\n    chunk = brick_arena_top->chunk;\n    if (chunk == NULL || chunk->used + n > chunk->cap) {\n        cap = n > BRICK_ARENA_CHUNK ? n : BRICK_ARENA_CHUNK;\n        chunk = malloc(sizeof(BrickArenaChunk) + cap);\n        if (chunk == NULL) {\n            brick_panic_memory();\n        }\n        chunk->prev = brick_arena_top->chunk;\n        chunk->used = 0;\n        chunk->cap  = cap;\n        brick_arena_top->chunk = chunk;\n    }\n    p = (char *)chunk + sizeof(BrickArenaChunk) + chunk->used;\n    chunk->used += n;\n    return p;\n}\n\nstatic inline void brick_arena_enter(BrickArena *arena)\n{\n    arena->parent = brick_arena_top;\n    arena->chunk  = NULL;\n    brick_arena_top = arena;\n}\n\nstatic inline void brick_arena_leave(BrickArena *arena)\n{\n    BrickArenaChunk *chunk = arena->chunk;\n\n    while (chunk != NULL) {\n        BrickArenaChunk *prev = chunk->prev;\n        free(chunk);\n        chunk = prev;\n    }\n    brick_arena_top = arena->parent;\n}\n\n/* Allocate n bytes from the active arena, or the heap when there is none. */\nstatic inline void *brick_alloc(size_t n)\n{\n    void *p;\n\n    if (brick_arena_top != NULL) {\n        return brick_arena_raw(n);\n    }\n    p = malloc(n);\n    if (p == NULL) {\n        brick_panic_memory();\n    }\n    return p;\n}\n\n/*\n * Resize a buffer to newsize bytes. Inside an arena the old buffer is left for\n * the arena to reclaim; otherwise realloc is used as usual.\n */\nstatic inline void *brick_resize(void *old, size_t oldsize, size_t newsize)\n{\n    void *p;\n\n    if (brick_arena_top != NULL) {\n        p = brick_arena_raw(newsize);\n        if (old != NULL) {\n            memcpy(p, old, oldsize);\n        }\n        return p;\n    }\n    p = realloc(old, newsize);\n    if (p == NULL) {\n        brick_panic_memory();\n    }\n    return p;\n}\n\nstatic inline BrickList brick_list_new(int64_t elem)\n{\n    BrickList list;\n\n    list.data = NULL;\n    list.len = 0;\n    list.cap = 0;\n    list.elem = elem;\n    return list;\n}\n\nstatic inline void brick_list_grow(BrickList *list, int64_t needed)\n{\n    int64_t cap;\n\n    if (needed <= list->cap) {\n        return;\n    }\n    cap = list->cap ? list->cap * BRICK_LIST_GROWTH_FACTOR\n                    : BRICK_LIST_INITIAL_CAPACITY;\n    if (cap < needed) {\n        cap = needed;\n    }\n    list->data = brick_resize(list->data,\n                              (size_t)(list->cap * list->elem),\n                              (size_t)(cap * list->elem));\n    list->cap = cap;\n}\n\nstatic inline void brick_list_push(BrickList *list, const void *value)\n{\n    brick_list_grow(list, list->len + 1);\n    memcpy((char *)list->data + list->len * list->elem, value, (size_t)list->elem);\n    list->len++;\n}\n\nstatic inline void *brick_list_at(BrickList *list, int64_t index)\n{\n    if (index < 0 || index >= list->len) {\n        brick_panic_index(index);\n    }\n    return (char *)list->data + index * list->elem;\n}\n\n/*\n * Return the half-open byte range [start, end) of s as fresh text. Bounds are\n * checked like list indexing; the bytes are copied so the slice is independent.\n */\nstatic inline const char *brick_text_slice(const char *s, int64_t start, int64_t end)\n{\n    size_t len;\n    char  *slice;\n\n    len = strlen(s);\n    if (start < 0 || end < start || end > (int64_t)len) {\n        brick_panic_index(start);\n    }\n    slice = brick_alloc((size_t)(end - start) + 1);\n    memcpy(slice, s + start, (size_t)(end - start));\n    slice[end - start] = '\\0';\n    return slice;\n}\n\nstatic inline const char *brick_text_concat(const char *left, const char *right)\n{\n    size_t left_len;\n    size_t right_len;\n    char  *joined;\n\n    left_len  = strlen(left);\n    right_len = strlen(right);\n    joined    = malloc(left_len + right_len + 1);\n    if (joined == NULL) {\n        brick_panic_memory();\n    }\n    memcpy(joined, left, left_len);\n    memcpy(joined + left_len, right, right_len + 1);\n    return joined;\n}\n\nstatic inline const char *brick_int_to_text(int64_t value)\n{\n    char     digits[24];   /* reversed digits, enough for any int64_t */\n    size_t   len = 0;\n    uint64_t magnitude;\n    char    *text;\n    size_t   i;\n\n    magnitude = value < 0 ? (uint64_t)(-(value + 1)) + 1u : (uint64_t)value;\n    do {\n        digits[len++] = (char)('0' + (int)(magnitude % 10u));\n        magnitude /= 10u;\n    } while (magnitude != 0);\n    if (value < 0) {\n        digits[len++] = '-';\n    }\n    text = brick_alloc(len + 1);\n    for (i = 0; i < len; i++) {\n        text[i] = digits[len - 1 - i];\n    }\n    text[len] = '\\0';\n    return text;\n}\n\nstatic inline const char *brick_float_to_text(double value)\n{\n    char *text = brick_alloc(32);\n\n    snprintf(text, 32, \"%g\", value);\n    return text;\n}\n\nstatic inline const char *brick_bool_to_text(bool value)\n{\n    return value ? \"true\" : \"false\";\n}\n\nstatic inline char *brick_read_file(const char *path)\n{\n    FILE  *file;\n    long   size;\n    char  *buffer;\n    size_t got;\n\n    file = fopen(path, \"rb\");\n    if (file == NULL) {\n        fprintf(stderr, \"brick: cannot open %s\\n\", path);\n        exit(1);\n    }\n    fseek(file, 0, SEEK_END);\n    size = ftell(file);\n    fseek(file, 0, SEEK_SET);\n    buffer = malloc((size_t)size + 1);\n    if (buffer == NULL) {\n        brick_panic_memory();\n    }\n    got = fread(buffer, 1, (size_t)size, file);\n    buffer[got] = '\\0';\n    fclose(file);\n    return buffer;\n}\n\nstatic inline void brick_write_file(const char *path, const char *contents)\n{\n    FILE *file;\n\n    file = fopen(path, \"wb\");\n    if (file == NULL) {\n        fprintf(stderr, \"brick: cannot write %s\\n\", path);\n        exit(1);\n    }\n    fwrite(contents, 1, strlen(contents), file);\n    fclose(file);\n}\n\n#define BRICK_PUSH(T, list, value)                       \\\n    do {                                                 \\\n        T brick_push_value = (value);                    \\\n        brick_list_push(&(list), &brick_push_value);     \\\n    } while (0)\n\n/*\n * Maps (Map(text, V)): a hash table with text keys and inline values, used for\n * symbol tables and the like. Keys are copied; values are stored by bytes.\n */\n\n/*\n * Text builder (Builder(), from Builder()): a growable buffer for assembling\n * output without quadratic string concatenation. add() appends; build() returns\n * the accumulated text. Growth goes through brick_resize, so a builder inside an\n * arena is freed with it.\n */\n\n#define BRICK_BUILDER_INITIAL_CAPACITY 32\n#define BRICK_BUILDER_GROWTH_FACTOR    2\n\ntypedef struct\n{\n    char   *data;\n    size_t  len;\n    size_t  cap;\n} BrickBuilder;\n\nstatic inline BrickBuilder brick_builder_new(void)\n{\n    BrickBuilder builder;\n\n    builder.data = NULL;\n    builder.len  = 0;\n    builder.cap  = 0;\n    return builder;\n}\n\nstatic inline void brick_builder_reserve(BrickBuilder *builder, size_t need)\n{\n    size_t cap;\n\n    if (need <= builder->cap) {\n        return;\n    }\n    cap = builder->cap ? builder->cap * BRICK_BUILDER_GROWTH_FACTOR\n                       : BRICK_BUILDER_INITIAL_CAPACITY;\n    while (cap < need) {\n        cap *= BRICK_BUILDER_GROWTH_FACTOR;\n    }\n    builder->data = brick_resize(builder->data, builder->cap, cap);\n    builder->cap  = cap;\n}\n\nstatic inline void brick_builder_add(BrickBuilder *builder, const char *text)\n{\n    size_t len = strlen(text);\n\n    brick_builder_reserve(builder, builder->len + len + 1);\n    memcpy(builder->data + builder->len, text, len);\n    builder->len += len;\n    builder->data[builder->len] = '\\0';\n}\n\n/*\n * Append an integer straight into the buffer, with no intermediate text and no\n * strlen: this is what an int passed to builder.add() compiles to.\n */\nstatic inline void brick_builder_add_int(BrickBuilder *builder, int64_t value)\n{\n    char     digits[24];   /* reversed digits, enough for any int64_t */\n    size_t   len = 0;\n    uint64_t magnitude;\n    size_t   i;\n\n    magnitude = value < 0 ? (uint64_t)(-(value + 1)) + 1u : (uint64_t)value;\n    do {\n        digits[len++] = (char)('0' + (int)(magnitude % 10u));\n        magnitude /= 10u;\n    } while (magnitude != 0);\n    if (value < 0) {\n        digits[len++] = '-';\n    }\n    brick_builder_reserve(builder, builder->len + len + 1);\n    for (i = 0; i < len; i++) {\n        builder->data[builder->len + i] = digits[len - 1 - i];\n    }\n    builder->len += len;\n    builder->data[builder->len] = '\\0';\n}\n\nstatic inline const char *brick_builder_build(BrickBuilder *builder)\n{\n    if (builder->data == NULL) {\n        builder->data = brick_alloc(1);\n        builder->data[0] = '\\0';\n    }\n    return builder->data;\n}\n\n#define BRICK_MAP_INITIAL_CAPACITY 8\n\ntypedef struct BrickMapEntry\n{\n    char                  *key;\n    struct BrickMapEntry  *next;\n    /* value bytes follow the header */\n} BrickMapEntry;\n\ntypedef struct\n{\n    BrickMapEntry **buckets;\n    int64_t         cap;     /* number of buckets     */\n    int64_t         len;     /* number of entries     */\n    int64_t         elem;    /* value size in bytes   */\n} BrickMap;\n\nstatic inline uint64_t brick_map_hash(const char *key)\n{\n    uint64_t h = 1469598103934665603ULL;   /* FNV-1a */\n\n    while (*key != '\\0') {\n        h ^= (unsigned char)*key++;\n        h *= 1099511628211ULL;\n    }\n    return h;\n}\n\nstatic inline BrickMap brick_map_new(int64_t elem)\n{\n    BrickMap map;\n\n    map.cap   = BRICK_MAP_INITIAL_CAPACITY;\n    map.len   = 0;\n    map.elem  = elem;\n    map.buckets = brick_alloc((size_t)map.cap * sizeof(BrickMapEntry *));\n    memset(map.buckets, 0, (size_t)map.cap * sizeof(BrickMapEntry *));\n    return map;\n}\n\nstatic inline BrickMapEntry *brick_map_find(BrickMap *map, const char *key)\n{\n    BrickMapEntry *entry = map->buckets[brick_map_hash(key) % (uint64_t)map->cap];\n\n    while (entry != NULL) {\n        if (strcmp(entry->key, key) == 0) {\n            return entry;\n        }\n        entry = entry->next;\n    }\n    return NULL;\n}\n\nstatic inline void brick_map_rehash(BrickMap *map)\n{\n    int64_t         newcap = map->cap * 2;\n    BrickMapEntry **buckets;\n    int64_t         i;\n\n    buckets = brick_alloc((size_t)newcap * sizeof(BrickMapEntry *));\n    memset(buckets, 0, (size_t)newcap * sizeof(BrickMapEntry *));\n    for (i = 0; i < map->cap; i++) {\n        BrickMapEntry *entry = map->buckets[i];\n        while (entry != NULL) {\n            BrickMapEntry *next = entry->next;\n            uint64_t       idx  = brick_map_hash(entry->key) % (uint64_t)newcap;\n            entry->next = buckets[idx];\n            buckets[idx] = entry;\n            entry = next;\n        }\n    }\n    map->buckets = buckets;\n    map->cap     = newcap;\n}\n\nstatic inline void brick_map_set(BrickMap *map, const char *key, const void *value)\n{\n    BrickMapEntry *entry = brick_map_find(map, key);\n    size_t         klen;\n    uint64_t       idx;\n\n    if (entry != NULL) {\n        memcpy((char *)entry + sizeof(BrickMapEntry), value, (size_t)map->elem);\n        return;\n    }\n    if (map->len >= map->cap) {\n        brick_map_rehash(map);\n    }\n    entry = brick_alloc(sizeof(BrickMapEntry) + (size_t)map->elem);\n    klen  = strlen(key);\n    entry->key = brick_alloc(klen + 1);\n    memcpy(entry->key, key, klen + 1);\n    memcpy((char *)entry + sizeof(BrickMapEntry), value, (size_t)map->elem);\n    idx = brick_map_hash(key) % (uint64_t)map->cap;\n    entry->next = map->buckets[idx];\n    map->buckets[idx] = entry;\n    map->len++;\n}\n\nstatic inline void *brick_map_get(BrickMap *map, const char *key)\n{\n    BrickMapEntry *entry = brick_map_find(map, key);\n\n    return entry != NULL ? (char *)entry + sizeof(BrickMapEntry) : NULL;\n}\n\nstatic inline void *brick_map_get_must(BrickMap *map, const char *key)\n{\n    void *value = brick_map_get(map, key);\n\n    if (value == NULL) {\n        fprintf(stderr, \"brick: missing map key: %s\\n\", key);\n        exit(1);\n    }\n    return value;\n}\n\nstatic inline int64_t brick_map_has(BrickMap *map, const char *key)\n{\n    return brick_map_find(map, key) != NULL;\n}\n\n#define BRICK_MAP_SET(T, map, key, value)                \\\n    do {                                                 \\\n        T brick_map_value = (value);                     \\\n        brick_map_set(&(map), (key), &brick_map_value);  \\\n    } while (0)\n/* --- end runtime --- */\n\n"
}

function argsRuntimeText() -> text {
    return "/*\n * Command-line arguments, captured by main and exposed as args().\n */\n\nstatic int    brick_saved_argc;\nstatic char **brick_saved_argv;\n\nstatic inline BrickList brick_args(void)\n{\n    BrickList   list;\n    int         i;\n    const char *arg;\n\n    list = brick_list_new(sizeof(const char *));\n    for (i = 0; i < brick_saved_argc; i++) {\n        arg = brick_saved_argv[i];\n        brick_list_push(&list, &arg);\n    }\n    return list;\n}\n\n"
}

function isDirRuntimeText() -> text {
    return "/*\n * is_dir(path): true when the path exists and is a directory, false otherwise.\n */\n\n#include <sys/stat.h>\n\nstatic inline bool brick_is_dir(const char *path)\n{\n    struct stat info;\n\n    if (stat(path, &info) != 0) {\n        return false;\n    }\n    return S_ISDIR(info.st_mode);\n}\n\n"
}

function readDirRuntimeText() -> text {
    return "/*\n * Directory listings: read_dir(path) returns every name in a directory,\n * sorted, without \".\" and \"..\", or an empty list when it cannot be opened.\n */\n\n#include <dirent.h>\n\nstatic int brick_name_compare(const void *a, const void *b)\n{\n    return strcmp(*(const char *const *)a, *(const char *const *)b);\n}\n\nstatic inline BrickList brick_read_dir(const char *path)\n{\n    BrickList      list;\n    DIR           *dir;\n    struct dirent *entry;\n    const char    *name;\n    char          *copy;\n    size_t         len;\n\n    list = brick_list_new(sizeof(const char *));\n    dir = opendir(path);\n    if (dir == NULL) {\n        return list;\n    }\n    while ((entry = readdir(dir)) != NULL) {\n        if (strcmp(entry->d_name, \".\") == 0 || strcmp(entry->d_name, \"..\") == 0) {\n            continue;\n        }\n        len = strlen(entry->d_name);\n        copy = brick_alloc(len + 1);\n        memcpy(copy, entry->d_name, len + 1);\n        name = copy;\n        brick_list_push(&list, &name);\n    }\n    closedir(dir);\n    if (list.len > 1) {\n        qsort(list.data, (size_t)list.len, sizeof(name), brick_name_compare);\n    }\n    return list;\n}\n\n"
}

function getenvRuntimeText() -> text {
    return "/*\n * Environment variables: getenv(name) returns \"\" when the name is not set.\n */\n\nstatic inline const char *brick_getenv(const char *name)\n{\n    const char *value = getenv(name);\n\n    return value != NULL ? value : \"\";\n}\n\n"
}

function systemRuntimeText() -> text {
    return "/*\n * Running a program: system(argv) starts argv[0] with the remaining\n * arguments, waits for it, and returns its exit status. No shell is\n * involved, so arguments arrive exactly as written.\n */\n\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <unistd.h>\n\nstatic inline int64_t brick_run(BrickList argv)\n{\n    char   **vec;\n    int64_t  i;\n    pid_t    pid;\n    int      status;\n\n    if (argv.len == 0) {\n        return 127;\n    }\n    fflush(stdout);\n    fflush(stderr);\n    vec = brick_alloc(sizeof(char *) * (size_t)(argv.len + 1));\n    for (i = 0; i < argv.len; i++) {\n        vec[i] = *(char **)((char *)argv.data + i * argv.elem);\n    }\n    vec[argv.len] = NULL;\n\n    pid = fork();\n    if (pid < 0) {\n        return 127;\n    }\n    if (pid == 0) {\n        execvp(vec[0], vec);\n        _exit(127);   /* exec failed: no such program */\n    }\n    if (waitpid(pid, &status, 0) < 0) {\n        return 127;\n    }\n    if (WIFEXITED(status)) {\n        return (int64_t)WEXITSTATUS(status);\n    }\n    if (WIFSIGNALED(status)) {\n        return (int64_t)(128 + WTERMSIG(status));\n    }\n    return 127;\n}\n\n"
}

function bytesRuntimeText() -> text {
    return "/*\n * Byte strings (bytes): a length-carrying buffer, so a value can hold bytes\n * that are not printable -- including NUL -- without truncation. text is a\n * NUL-terminated C string and cannot; bytes exists for exactly that case.\n */\n\ntypedef struct\n{\n    char   *data;\n    int64_t len;\n} BrickBytes;\n\nstatic inline BrickBytes brick_bytes_new(const char *data, int64_t len)\n{\n    BrickBytes bytes;\n\n    bytes.data = brick_alloc((size_t)len + 1);\n    bytes.len  = len;\n    if (len > 0) {\n        memcpy(bytes.data, data, (size_t)len);\n    }\n    bytes.data[len] = '\\0';   /* handy, not authoritative */\n    return bytes;\n}\n\nstatic inline BrickBytes brick_bytes_from_list(BrickList xs)\n{\n    BrickBytes bytes;\n    int64_t    i;\n\n    bytes.data = brick_alloc((size_t)xs.len + 1);\n    bytes.len  = xs.len;\n    for (i = 0; i < xs.len; i++) {\n        bytes.data[i] = (char)(unsigned char)(*(int64_t *)((char *)xs.data + i * xs.elem) & 0xff);\n    }\n    bytes.data[xs.len] = '\\0';\n    return bytes;\n}\n\nstatic inline int64_t brick_bytes_at(BrickBytes bytes, int64_t index)\n{\n    if (index < 0 || index >= bytes.len) {\n        brick_panic_index(index);\n    }\n    return (int64_t)(unsigned char)bytes.data[index];\n}\n\nstatic inline int brick_bytes_eq(BrickBytes a, BrickBytes b)\n{\n    if (a.len != b.len) {\n        return 0;\n    }\n    return a.len == 0 || memcmp(a.data, b.data, (size_t)a.len) == 0;\n}\n\nstatic inline void brick_print_bytes(BrickBytes bytes)\n{\n    fwrite(bytes.data, 1, (size_t)bytes.len, stdout);\n}\n\nstatic inline const char *brick_bytes_to_text(BrickBytes bytes)\n{\n    char *text = brick_alloc((size_t)bytes.len + 1);\n\n    memcpy(text, bytes.data, (size_t)bytes.len);\n    text[bytes.len] = '\\0';\n    return text;\n}\n\nstatic inline BrickBytes brick_to_bytes(const char *text)\n{\n    return brick_bytes_new(text, (int64_t)strlen(text));\n}\n\n"
}
