// std/math — basic math utilities for Brick.
//
// Because Brick has no generics, int and float variants have separate names.

// ---- int ----

function abs(n: int) -> int {
    if n < 0 {
        return 0 - n
    }
    return n
}

function min(a: int, b: int) -> int {
    if a < b {
        return a
    }
    return b
}

function max(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

function clamp(n: int, lo: int, hi: int) -> int {
    if n < lo {
        return lo
    }
    if n > hi {
        return hi
    }
    return n
}

// ---- float ----

function abs_float(n: float) -> float {
    if n < 0.0 {
        return 0.0 - n
    }
    return n
}

function min_float(a: float, b: float) -> float {
    if a < b {
        return a
    }
    return b
}

function max_float(a: float, b: float) -> float {
    if a > b {
        return a
    }
    return b
}

function clamp_float(n: float, lo: float, hi: float) -> float {
    if n < lo {
        return lo
    }
    if n > hi {
        return hi
    }
    return n
}

