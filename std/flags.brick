// std/flags — command-line argument and flag parsing for Brick.

import "strings"

// has_flag returns true if flag (e.g. "-v" or "--min") is present in argv.
function has_flag(argv: List(text), flag: text) -> bool {
    var i = 1
    while i < argv.len {
        if argv[i] == "--" {
            break
        }
        if argv[i] == flag {
            return true
        }
        i = i + 1
    }
    return false
}

// flag_value finds a flag's string value, supporting both "--name value"
// and "--name=value". Returns default_val if the flag was not provided.
function flag_value(argv: List(text), flag: text, default_val: text) -> text {
    var i = 1
    var eq_prefix = flag + "="
    while i < argv.len {
        if argv[i] == "--" {
            break
        }
        if argv[i] == flag {
            if i + 1 < argv.len {
                return argv[i + 1]
            }
        } else if starts_with(argv[i], eq_prefix) {
            return slice(argv[i], eq_prefix.len, argv[i].len)
        }
        i = i + 1
    }
    return default_val
}

// flag_int finds a flag's integer value. Returns default_val if missing.
function flag_int(argv: List(text), flag: text, default_val: int) -> int {
    var v = flag_value(argv, flag, "")
    if v.len == 0 {
        return default_val
    }
    return parse_int(v)
}

// positionals returns all arguments that are not flags.
// valued_flags is a list of flag names that take a parameter (e.g. ["-o", "--out"]),
// so their parameter is not treated as a positional argument.
function positionals(argv: List(text), valued_flags: List(text)) -> List(text) {
    var res = List(text)
    var skip_next = false
    var i = 1
    while i < argv.len {
        var a = argv[i]
        if skip_next {
            skip_next = false
        } else if a == "--" {
            i = i + 1
            while i < argv.len {
                res.push(argv[i])
                i = i + 1
            }
            break
        } else if a.len > 1 && a[0] == '-' {
            if contains(a, "=") == false {
                var j = 0
                while j < valued_flags.len {
                    if a == valued_flags[j] {
                        skip_next = true
                        break
                    }
                    j = j + 1
                }
            }
        } else {
            res.push(a)
        }
        i = i + 1
    }
    return res
}

