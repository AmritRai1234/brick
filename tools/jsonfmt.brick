import "../std/flags"
import "../std/strings"

function main() {
    var argv = args()
    var val_flags = List(text)
    var pos = positionals(argv, val_flags)
    var minify = has_flag(argv, "--min")
    var path = "-"
    if pos.len > 0 {
        path = pos[0]
    }

    var src = read_file(path)
    var n = src.len
    var out = Builder()
    var in_string = false
    var depth = 0
    var i = 0
    var last_sig = ' '
    while i < n {
        var c = src[i]
        if in_string {
            out.add(slice(src, i, i + 1))
            if c == '\\' {
                i = i + 1
                if i < n {
                    out.add(slice(src, i, i + 1))
                }
            } else if c == '"' {
                in_string = false
                last_sig = '"'
            }
        } else {
            if c == '"' {
                in_string = true
                out.add(slice(src, i, i + 1))
                last_sig = '"'
            } else if c == '{' || c == '[' {
                out.add(slice(src, i, i + 1))
                depth = depth + 1
                if minify == false {
                    out.add("\n")
                    out.add(repeat("  ", depth))
                }
                last_sig = c
            } else if c == '}' || c == ']' {
                depth = depth - 1
                if minify == false {
                    var is_empty = (c == '}' && last_sig == '{') || (c == ']' && last_sig == '[')
                    if is_empty == false {
                        out.add("\n")
                        out.add(repeat("  ", depth))
                    }
                }
                out.add(slice(src, i, i + 1))
                last_sig = c
            } else if c == ',' {
                out.add(",")
                if minify == false {
                    out.add("\n")
                    out.add(repeat("  ", depth))
                }
                last_sig = ','
            } else if c == ':' {
                if minify == false {
                    out.add(": ")
                } else {
                    out.add(":")
                }
                last_sig = ':'
            } else if is_space(c) {
                // skip insignificant whitespace
            } else {
                out.add(slice(src, i, i + 1))
                last_sig = c
            }
        }
        i = i + 1
    }
    print(out.build())
}
