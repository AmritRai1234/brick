// getenv(name) reads an environment variable; an unset name is "" (never a
// NUL pointer), so .len is always safe.
function main() {
    var value = getenv("BRICK_EXAMPLE_ENV")
    if value.len == 0 {
        print("BRICK_EXAMPLE_ENV is not set")
    } else {
        print("BRICK_EXAMPLE_ENV=" + value)
    }
    print(getenv("BRICK_NO_SUCH_VARIABLE").len)
}
